.home__header {
  background: linear-gradient(180deg, #E6F7F4 0%, var(--color-bg) 100%);
  padding-bottom: 24rpx;
}

.home__header-inner {
  padding: 16rpx var(--page-padding) 0;
}

.home__title {
  display: block;
  font-size: var(--font-title-lg);
  font-weight: 600;
  color: var(--color-primary-dark);
  margin-bottom: 24rpx;
}

.home__body {
  height: calc(100vh - 200rpx);
}

.home__content {
  padding: 0 var(--page-padding) var(--page-padding);
}

.home__doctors .doctor-card:last-child {
  margin-bottom: 0;
}
