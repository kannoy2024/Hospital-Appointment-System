.triage-result__scroll {
  height: calc(100vh - 46px - 120rpx);
}

.triage-result__content {
  padding: 24rpx 32rpx;
}

.triage-result__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 64rpx 32rpx;
}

.triage-result__loading-text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.triage-result__summary {
  margin-bottom: var(--spacing-md);
}

.triage-result__summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.triage-result__label {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--color-text);
}

.triage-result__source {
  font-size: var(--font-small);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.triage-result__block {
  margin-bottom: 24rpx;
}

.triage-result__block-title {
  display: block;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.triage-result__block-body {
  display: block;
  font-size: var(--font-body);
  color: var(--color-text);
  line-height: 1.6;
}

.triage-result__signs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.triage-result__sign {
  font-size: var(--font-small);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
}

.triage-result__user-symptom {
  padding-top: 8rpx;
  margin-bottom: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.triage-result__ai-summary {
  display: block;
  font-size: var(--font-body);
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.triage-result__symptom-label {
  display: block;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.triage-result__symptom {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.triage-result__urgent {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: #FFF7E6;
  border-radius: var(--radius-sm);
  font-size: var(--font-small);
  color: #FA8C16;
}

.triage-result__advice {
  display: block;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.triage-result__footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--color-surface);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
