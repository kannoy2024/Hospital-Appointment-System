.triage__scroll {
  height: calc(100vh - 46px - var(--bottom-bar-height));
}

.triage__content {
  padding: 24rpx 32rpx;
}

.triage__steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.triage__step {
  font-size: var(--font-small);
  color: var(--color-text-placeholder);
}

.triage__step--active {
  color: var(--color-primary);
  font-weight: 500;
}

.triage__step-arrow {
  font-size: var(--font-small);
  color: var(--color-text-placeholder);
}

.triage__quick {
  margin-bottom: var(--spacing-md);
}

.triage__quick-label {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.triage__quick-scroll {
  width: 100%;
  white-space: nowrap;
}

.triage__quick-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.triage__quick-tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: var(--font-caption);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: 1rpx solid rgba(0, 184, 148, 0.2);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.triage__quick-tag:active {
  opacity: 0.75;
}
