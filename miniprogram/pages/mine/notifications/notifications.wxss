.notifications {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.notifications__toolbar {
  padding: 8px 16px;
  text-align: right;
}

.notifications__read-all {
  color: #00b894;
  font-size: 14px;
}

.notifications__scroll {
  flex: 1;
  height: 0;
  padding: 0 12px 24px;
  box-sizing: border-box;
}

.notifications__loading {
  text-align: center;
  color: #999;
  padding: 24px;
}

.notifications__item {
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 10px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

.notifications__item--unread {
  border-left: 3px solid #00b894;
}

.notifications__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}

.notifications__title {
  font-size: 16px;
  font-weight: 600;
  color: #222;
}

.notifications__type {
  display: block;
  font-size: 12px;
  color: #00b894;
  margin-bottom: 6px;
}

.notifications__content {
  display: block;
  font-size: 14px;
  color: #555;
  line-height: 1.5;
}

.notifications__time {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  color: #aaa;
}
