.evaluate__content {
  padding: 24rpx 32rpx;
}

.evaluate__doctor {
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.evaluate__name {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.evaluate__dept {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.evaluate__label {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}
