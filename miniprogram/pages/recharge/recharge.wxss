@import '../../styles/pay.wxss';

.recharge-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 0 32rpx calc(180rpx + env(safe-area-inset-bottom));
}

.balance-card {
  padding: 40rpx 32rpx;
  margin: 24rpx 0 20rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #34d399, #00B894);
  box-shadow: var(--shadow-card);
}

.balance-card__label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.balance-card__value {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.card__title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card__title--inline { margin-bottom: 0; }

.card__hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.amount-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid var(--color-border);
  font-size: 28rpx;
  color: var(--color-text);
}

.amount-item--active {
  border-color: var(--color-primary);
  background: rgba(0, 184, 148, 0.08);
  color: var(--color-primary);
  font-weight: 600;
}

.amount-hint {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(0, 184, 148, 0.06);
}

.amount-hint__label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.amount-hint__yuan {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.amount-hint__fen {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.empty-logs {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.log-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.log-item:last-child { border-bottom: none; }

.log-item__title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
}

.log-item__time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.log-item__amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: var(--color-surface);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}
