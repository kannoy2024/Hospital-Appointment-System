.doctor-header {
  display: flex;
  gap: 28rpx;
  padding: 32rpx;
  background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-surface) 100%);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.doctor-header__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-card);
}

.doctor-header__name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.doctor-header__name {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--color-text);
}

.doctor-header__title {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.doctor-header__hospital {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.doctor-header__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-small);
  color: var(--color-text-placeholder);
  margin-bottom: 12rpx;
}

.doctor-header__split {
  color: var(--color-border);
}

.doctor-header__intro {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.doctor-header__fav {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx;
  z-index: 1;
}