.dept-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 16rpx 8rpx;
  box-shadow: var(--shadow-card);
}

.dept-grid__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
}

.dept-grid__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.dept-grid__img {
  width: 48rpx;
  height: 48rpx;
}

.dept-grid__name {
  font-size: var(--font-small);
  color: var(--color-text);
  text-align: center;
}
