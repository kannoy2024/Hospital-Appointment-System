.banner-swiper {
  position: relative;
  width: 100%;
  margin-bottom: var(--spacing-md);
}

.banner-swiper__inner {
  width: 100%;
  height: 281rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.banner-swiper__slide {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.banner-swiper__slide--image {
  width: 100%;
  height: 100%;
}

.banner-swiper__slide--tap {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.banner-swiper__slide--pressed {
  opacity: 0.88;
  transform: scale(0.985);
}

.banner-swiper__bg {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-swiper__slide--card {
  display: flex;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(90deg, #0DB894 0%, #2ECFC5 55%, #7AD8F5 100%);
}

.banner-swiper__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 1;
}

.banner-swiper__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.banner-swiper__subtitle {
  font-size: var(--font-subtitle);
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.banner-swiper__tagline {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.banner-swiper__illus {
  width: 300rpx;
  height: 100%;
  flex-shrink: 0;
  opacity: 0.95;
}

.banner-swiper__dots {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 2;
}

.banner-swiper__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}

.banner-swiper__dot--active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #fff;
}
